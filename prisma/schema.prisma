generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres, session pooler (port 5432) for BOTH urls.
//
// DATABASE_URL used to point at the transaction pooler (port 6543,
// pgbouncer=true); that made every query ~2s instead of ~0.2s. Prisma needs
// prepared statements and the transaction pooler gives each query a different
// backend, so 6543 is either slow (with pgbouncer=true) or broken without it
// — see the measurements in .env.example. Do not move this back to 6543.
//
// DIRECT_URL is what migrate/push use — Supabase's true "direct connection"
// is IPv6-only and unreachable from this network, but the session pooler
// behaves like a direct connection for schema changes and IS reachable.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Platform {
  SHOPEE
  TIKTOK
  LAZADA
}

enum UserRole {
  ADMIN
  STAFF
}

enum OrderStatus {
  NEW
  PENDING_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  RETURNED
  PROBLEM
}

enum ProblemType {
  DELAYED_SHIPMENT
  BUYER_COMPLAINT
  REFUND_DISPUTE
  LOST_PACKAGE
  DAMAGED_ITEM
  WRONG_ITEM
  CHARGEBACK
  OTHER
}

enum ProblemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Where a shop-policy warning came from — most come from livestreams or
/// video content rather than a specific order, unlike ProblemTicket above.
enum ViolationSource {
  LIVESTREAM
  VIDEO_CONTENT
  PRODUCT_LISTING
  ACCOUNT
  OTHER
}

model Order {
  id              String      @id @default(cuid())
  platform        Platform
  platformOrderId String
  status          OrderStatus @default(NEW)

  buyerName     String?
  buyerPhone    String?
  buyerUsername String?
  /// District + province only (e.g. "เกาะลันตา, กระบี่") — the one part of
  /// the shipping address TikTok Shop's API does NOT mask for privacy; the
  /// street-level address is redacted server-side by TikTok and never
  /// reaches this app at all, so there's nothing more precise to store.
  buyerRegion   String?

  // Kept as Float (not Decimal) on purpose even though Postgres now supports
  // it — switching would return a Prisma Decimal object instead of a plain
  // number everywhere totalAmount is read (17 files do arithmetic/display on
  // it), a breaking change with real regression risk that's out of scope
  // for a straight provider migration. Worth doing as its own deliberate
  // follow-up, not bundled in here.
  totalAmount Float
  currency    String @default("THB")

  orderDate       DateTime
  shippingCarrier String?
  trackingNumber  String?
  shippingStatus  String?
  /// When this order's tracking number arrived — the warehouse rule is that
  /// the day it arrives is the day the order ships, and the shipping summary
  /// buckets on it (see shippingSummary.ts). Which source wins is decided in
  /// printedAt.ts: TikTok's own label time (rts_time) when there is one,
  /// otherwise the first time this system saw the number. Null means no
  /// tracking number yet; the order counts as pending for whichever day is
  /// "today" until it gets one. Not a log of anyone pressing print.
  printedAt       DateTime?

  /// Which store this order came from, for platforms where one seller
  /// account can run multiple shops (e.g. several TikTok Shop stores).
  /// Null for platforms/orders synced before multi-shop support existed.
  shopId   String?
  shopName String?

  /// True when the platform itself reports this order as still awaiting
  /// payment (TikTok's "UNPAID" order_status, Shopee's "ยังไม่ชำระ", Lazada's
  /// "unpaid" export status) — these currently all collapse into
  /// OrderStatus.NEW same as an already-paid-but-unconfirmed order, so this
  /// is the only signal that distinguishes them. Used to keep unpaid orders
  /// out of the shipping-summary packing list (see shippingSummary.ts) —
  /// nothing ships before it's paid for.
  isUnpaid Boolean @default(false)

  /// Why this order was cancelled, lifted out of the platform's payload at
  /// sync/import time. All three platforms report the reason and the
  /// initiator — TikTok through the API (cancel_reason /
  /// cancellation_initiator / cancel_time), Shopee and Lazada inside their
  /// own order exports (see platforms/cancellationFields.ts). Only TikTok
  /// carries a timestamp, so cancelledAt stays null for the other two.
  ///
  /// Denormalised rather than read from rawPayload on demand for the same
  /// reason printedAt is: the cancellations page groups and date-filters on
  /// them, and doing that through a JSON operator means detoasting a ~2.3KB
  /// payload per row with no index to lean on — exactly the shape of the
  /// slow-page problem 59d1fdc fixed.
  cancelReason    String?
  /// BUYER, SELLER or SYSTEM, verbatim from the platform.
  cancelInitiator String?
  cancelledAt     DateTime?

  /// A return/refund AFTER the order shipped — a different event from a
  /// cancellation, which happens before it. Kept in its own columns rather
  /// than reusing cancelReason so the cancellations report can't silently
  /// count a damaged-on-arrival return as a buyer changing their mind.
  ///
  /// Only Lazada reports these today, through its returns export (the
  /// "ราการคืนสินค้า" file) — Shopee's order export has a
  /// "สถานะการคืนเงินหรือคืนสินค้า" column but no reason, and TikTok's API
  /// returns aren't wired up. Null therefore means "no return recorded",
  /// not "no return happened".
  returnReason String?
  returnedAt   DateTime?
  /// What the platform actually refunded, in THB. Can differ from
  /// totalAmount (partial refunds, shipping handled separately).
  refundAmount Float?

  rawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  problem       ProblemTicket?

  @@unique([platform, platformOrderId])
  @@index([status])
  @@index([shopId])
  @@index([orderDate])
  @@index([buyerPhone])
  // The shipping summary (shippingSummary.ts) and the dashboard's
  // "shipped today by channel" donut both bucket orders by printedAt, which
  // was a sequential scan of the whole table on every page load.
  @@index([printedAt])
  // The orders page's shop dropdowns and getChannelStatuses() both filter by
  // platform alone; the composite also serves the very common
  // "one channel, recent orders" filter on the orders and sales pages.
  @@index([platform, orderDate])
  // The cancellations page's every query: cancelled orders inside a date
  // window, grouped by reason/initiator. Keyed on orderDate, not cancelledAt,
  // because that page filters by order date like every other page here — and
  // because the 36 imported Shopee/Lazada cancellations have no cancelledAt
  // at all, so a cancelledAt window would silently drop them.
  @@index([status, orderDate])
  /// The returns report filters on "has a return" within a date window; without
  /// this it is a full scan of every order ever synced.
  @@index([returnedAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sku         String
  productName String
  quantity    Int
  unitPrice   Float
  imageUrl    String?

  @@index([orderId])
  @@index([sku])
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status     OrderStatus
  note       String?
  occurredAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model ProblemTicket {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type        ProblemType
  priority    ProblemPriority @default(MEDIUM)
  description String
  isResolved  Boolean         @default(false)
  resolvedAt  DateTime?
  assignee    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isResolved])
  @@index([priority])
}

/// A platform policy warning/violation not tied to any specific order — e.g.
/// a livestream or video flagged for breaking TikTok Shop's rules. Kept
/// separate from ProblemTicket since that model requires an orderId.
model PolicyViolation {
  id          String          @id @default(cuid())
  platform    Platform
  source      ViolationSource
  title       String
  description String
  priority    ProblemPriority @default(MEDIUM)
  isResolved  Boolean         @default(false)
  resolvedAt  DateTime?
  occurredAt  DateTime        @default(now())
  evidenceUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isResolved])
  @@index([platform])
}

model SyncLog {
  id           String    @id @default(cuid())
  platform     Platform
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  ordersSynced Int       @default(0)
  success      Boolean   @default(false)
  errorMessage String?

  // getLastSyncedLabel() runs on EVERY page (it feeds the top bar) as
  // "latest successful sync", and getChannelStatuses() runs the same query
  // narrowed to one platform. The scheduler appends rows every 5 minutes, so
  // this table only grows — without these it was an unindexed scan each time.
  @@index([success, finishedAt])
  @@index([platform, success, finishedAt])
}

/// One TikTok Shop OAuth grant (from one merchant clicking "Authorize").
/// A single grant's access/refresh token pair can cover multiple shops.
model TikTokAuthorization {
  id                   String   @id @default(cuid())
  accessToken          String
  accessTokenExpireAt  DateTime
  refreshToken         String
  refreshTokenExpireAt DateTime
  sellerName           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops TikTokShop[]
}

/// One employee login account. Plain per-account username/password, managed
/// from the in-app admin page rather than a self-serve signup flow — there's
/// no public registration since every account here maps to an actual staff
/// member the company already knows about.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)

  // Profile picture, kept in the row rather than object storage: this is a
  // staff-only tool with a handful of accounts, so a few hundred KB of bytea
  // costs less than adding a storage client, a bucket and a service key.
  // avatarUpdatedAt is what the <img> URL carries as ?v=, so a new upload
  // busts the browser cache instead of showing the old picture. Never select
  // avatarData alongside the other user fields — see src/lib/dal.ts.
  avatarData      Bytes?
  avatarMimeType  String?
  avatarUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityLogs ActivityLog[]

  chatMemberships ConversationParticipant[]
  chatMessages    Message[]

  @@index([isActive])
}

enum ConversationKind {
  /// The one room everybody is in. Exactly one row, id "team" — see
  /// TEAM_CONVERSATION_ID in src/lib/chat.ts.
  TEAM
  /// A private thread between exactly two people.
  DIRECT
}

/// A chat thread: either the shared team room or a two-person DM.
model Conversation {
  id   String           @id @default(cuid())
  kind ConversationKind

  /// DIRECT only: both user ids sorted and joined with "|". Unique, so two
  /// people who happen to open a thread with each other at the same moment
  /// can't end up with two parallel DM threads — the second insert loses the
  /// race against this constraint instead of silently splitting the history.
  dmKey String? @unique

  /// Denormalised from the newest message so the conversation list can sort
  /// and show a preview without touching the messages table per row.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

/// Someone's membership of a thread — and, the real reason this table exists,
/// where their "read up to here" mark lives. Team-room rows are created the
/// first time that person loads the chat rather than up front, so adding an
/// employee doesn't mean backfilling rows.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// SetNull rather than Cascade: deleting an employee shouldn't punch holes
  /// in everyone else's conversation. senderName keeps the message readable
  /// after the account is gone.
  senderId   String?
  sender     User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String

  body      String
  createdAt DateTime @default(now())

  /// The exact shape of every poll: "this thread, newer than this timestamp".
  @@index([conversationId, createdAt])
}

/// One row per action a logged-in user took (login/logout, employee-account
/// changes, resolving a problem ticket, triggering a manual sync, ...) — an
/// admin-facing audit trail, not the order-event feed on /problems (that one
/// tracks what happened to ORDERS, this tracks what PEOPLE did).
/// `username` is a point-in-time snapshot so the log still reads sensibly
/// after the account behind `userId` is later deleted (onDelete: SetNull).
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// A shop authorized under a TikTokAuthorization grant. shopCipher is
/// required on every TikTok Shop Orders API call alongside the access token.
model TikTokShop {
  id         String  @id @default(cuid())
  shopId     String  @unique
  shopCipher String
  shopName   String?
  region     String?

  authorizationId String
  authorization   TikTokAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  /// Set once the one-time full order history backfill finishes for this shop.
  /// While null, the dashboard offers the backfill button; regular syncs only
  /// ever pull today's orders regardless of this field.
  historyBackfilledAt      DateTime?
  historyBackfillStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Generic key/value store for small pieces of runtime config that aren't
/// worth their own table — e.g. which LINE group the shipping summary gets
/// pushed to, captured from the LINE webhook rather than hand-typed.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A manually-ticked "shipped" checkbox on the shipping-summary page, one per
/// SKU row per carrier per ship date — lets warehouse staff track packing
/// progress independent of platform status (which lags or never updates for
/// manually-imported Shopee/Lazada orders). Ticking is a pure UI action with
/// no effect on Order.status.
model ShippingChecklistItem {
  id        String   @id @default(cuid())
  shipDate  String
  /// The specific order this tick applies to — two different orders sharing
  /// a SKU/carrier/shop must never share a checklist row (see
  /// shippingSummary.ts: order-items are deliberately not merged).
  orderId   String
  sku       String
  checked   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([shipDate, orderId, sku])
}

/// A platform's raw seller_sku doesn't always match what the shop actually
/// calls a product internally — lets staff rename how a SKU displays across
/// the shipping summary (page, LINE messages, Excel export) without touching
/// the underlying OrderItem.sku or the platform's own data.
model SkuAlias {
  id         String   @id @default(cuid())
  rawSku     String   @unique
  displaySku String
  updatedAt  DateTime @updatedAt
}
