# --- Database (Supabase Postgres) ---
#
# IMPORTANT: use the SESSION pooler (port 5432) for BOTH urls, not the
# transaction pooler (port 6543). Prisma relies on prepared statements, and
# the transaction pooler routes each query to a different backend, which
# breaks them. Measured on this project:
#   6543 + pgbouncer=true -> correct, but ~2036ms per query (10x slower)
#   6543 without the flag -> ~289ms, but 133/150 concurrent queries FAIL with
#                            `prepared statement "sN" does not exist`
#   5432 session pooler   -> ~205ms per query, 150/150 queries pass
# Do not "optimize" this back to 6543.
#
# Keep connection_limit well under the pooler's pool_size (15 on this
# project): session mode holds a real Postgres backend open per pooled
# connection, so an oversized pool exhausts the connection budget instead of
# helping. It was 10, which left only 5 spare — running `next build` or a
# `tsx scripts/...` alongside `next dev` blew past 15 and every query died
# with `FATAL: (EMAXCONNSESSION) max clients reached in session mode`. At 3,
# a dev server, a build and a script can coexist.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=3&pool_timeout=20"

# Used by `prisma migrate` / `prisma db push` for schema changes. Supabase's
# true direct connection is IPv6-only and unreachable from some networks; the
# session pooler behaves like a direct connection for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Signs the login session cookie (see src/lib/session.ts). The app refuses to
# start without it; changing it invalidates every logged-in session.
SESSION_SECRET=

# --- TikTok Shop (app registered — connect a shop via /api/tiktok/authorize) ---
TIKTOK_SHOP_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=
TIKTOK_SHOP_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_SHOP_TOKEN_URL=https://auth.tiktok-shops.com/api/v2/token/get
TIKTOK_SHOP_REFRESH_URL=https://auth.tiktok-shops.com/api/v2/token/refresh

# --- Shopee Open Platform (not yet issued — leave blank to use mock data) ---
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=

# --- Lazada Open Platform (not yet issued — leave blank to use mock data) ---
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=
